{
  "name": "pi-task-system",
  "private": true,
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:pic",
    "build:web": "cd ../go-pic/web && npm run build",
    "build:pic": "cd ../go-pic && mkdir -p dist && go build -o dist/pic ./cmd/pic",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test core/*.test.ts tasking/*.test.ts pipeline/*.test.ts subagent/*.test.ts ui/*.test.ts reporting/*.test.ts",
    "lint": "eslint pipeline tasking"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  }
}
